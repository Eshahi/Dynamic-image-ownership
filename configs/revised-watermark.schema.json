{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Eshahi/Dynamic-image-ownership/blob/main/configs/revised-watermark.schema.json",
  "title": "Runnable image-domain QIM watermark candidate v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "qim_step", "minimum_side", "minimum_dynamic_range", "clip_tolerance", "repetition_floor", "frequencies", "owner_bits", "binding_bits", "thresholds"],
  "properties": {
    "schema_version": {"const": "revised-watermark-v2"},
    "profile": {"const": "image-domain-dct-qim-public-owner"},
    "qim_step": {"type": "number", "exclusiveMinimum": 0, "maximum": 32},
    "minimum_side": {"const": 160},
    "minimum_dynamic_range": {"const": 8.0},
    "clip_tolerance": {"const": 8.0},
    "repetition_floor": {"const": 3},
    "frequencies": {
      "const": [[1, 2], [2, 1], [2, 2], [1, 3], [3, 1], [2, 3]]
    },
    "owner_bits": {"const": 48},
    "binding_bits": {"const": 12},
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_accuracy", "instance_accuracy", "confidence"],
      "properties": {
        "owner_accuracy": {"type": "number", "minimum": 0.5, "maximum": 1},
        "instance_accuracy": {"type": "number", "minimum": 0.5, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0.5, "maximum": 1}
      }
    }
  }
}
