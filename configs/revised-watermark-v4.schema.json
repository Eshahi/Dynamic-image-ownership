{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Eshahi/Dynamic-image-ownership/blob/main/configs/revised-watermark-v4.schema.json",
  "title": "Content-bound dual-key DCT watermark, image-domain reference v4",
  "description": "Static shape of a v4 profile. scripts/revised_watermark_v4.py additionally requires JSON integers without a decimal point, the semantic and instance coefficient sets to be disjoint, and positions [0, 1] and [1, 0] to stay unused because the perceptual hash reads them, and each radius to be smaller than its mismatch distance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "security",
    "semantic_source",
    "minimum_side",
    "semantic_frequencies",
    "instance_frequencies",
    "code_bits",
    "tag_bits",
    "embedding",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "const": "revised-watermark-v4"
    },
    "profile": {
      "const": "image-domain-dual-key-dct-iss"
    },
    "security": {
      "enum": [
        "public-derived",
        "hmac-keyed"
      ]
    },
    "semantic_source": {
      "type": "string",
      "pattern": "^(proxy-layout-v1|external:[A-Za-z0-9._@/+:-]{1,128})$",
      "not": {
        "pattern": "\\s"
      }
    },
    "minimum_side": {
      "type": "integer",
      "minimum": 160,
      "maximum": 16384
    },
    "semantic_frequencies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2,
        "not": {
          "enum": [
            [
              0,
              0
            ],
            [
              0,
              1
            ],
            [
              1,
              0
            ]
          ]
        }
      }
    },
    "instance_frequencies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2,
        "not": {
          "enum": [
            [
              0,
              0
            ],
            [
              0,
              1
            ],
            [
              1,
              0
            ]
          ]
        }
      }
    },
    "code_bits": {
      "const": 32
    },
    "tag_bits": {
      "const": 128
    },
    "embedding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_psnr_db",
        "semantic_energy_share",
        "design_noise_std",
        "passes"
      ],
      "properties": {
        "target_psnr_db": {
          "type": "number",
          "minimum": 30,
          "maximum": 60
        },
        "semantic_energy_share": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 0.95
        },
        "design_noise_std": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 64
        },
        "passes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "false_positive_target",
        "semantic_radius",
        "semantic_mismatch_distance",
        "instance_radius",
        "instance_mismatch_distance"
      ],
      "properties": {
        "false_positive_target": {
          "type": "number",
          "minimum": 1e-20,
          "maximum": 0.01
        },
        "semantic_radius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "semantic_mismatch_distance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "instance_radius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "instance_mismatch_distance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      }
    }
  }
}
