{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "claims",
  "type": "object",
  "properties": {
    "claim_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
      },
      "minItems": 0
    },
    "run_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
      },
      "minItems": 0
    },
    "analysis_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "kind": {
      "enum": [
        "result",
        "interpretation",
        "limitation",
        "future-work"
      ]
    },
    "author_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    }
  },
  "required": [
    "claim_id",
    "text",
    "evidence_ids",
    "run_ids",
    "analysis_paths",
    "kind",
    "author_id"
  ],
  "additionalProperties": false
}
