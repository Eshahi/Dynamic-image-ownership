{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gate-decision",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "step_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "verdict": {
      "enum": [
        "approve",
        "reject",
        "revise",
        "retry",
        "stop"
      ]
    },
    "state_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "run_id",
    "step_id",
    "verdict",
    "state_sha256",
    "timestamp",
    "expires_at",
    "actor",
    "source_ref"
  ],
  "additionalProperties": false
}
